          "value": "corrective"
        },
        {
          "label": "Action préventive (évite la récurrence)",
          "value": "preventive"
        },
        {
          "label": "Action d'amélioration",
          "value": "improvement"
        }
      ],
      "type": "select",
      "layout": {
        "row": "Row_Action2_Type",
        "columns": null
      },
      "id": "Field_Action2_Type",
      "key": "action2Type",
      "searchable": true
    },
    {
      "label": "Description de l'action",
      "type": "textarea",
      "layout": {
        "row": "Row_Action2_Desc",
        "columns": null
      },
      "id": "Field_Action2_Description",
      "key": "action2Description",
      "description": "Décrivez précisément l'action à réaliser",
      "rows": 4
    },
    {
      "label": "Responsable de l'action",
      "type": "textfield",
      "layout": {
        "row": "Row_Action2_Owner",
        "columns": null
      },
      "id": "Field_Action2_Owner",
      "key": "action2Owner",
      "description": "Nom de la personne responsable"
    },
    {
      "label": "Date limite",
      "type": "datetime",
      "layout": {
