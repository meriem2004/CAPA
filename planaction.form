    },
    {
      "label": "Date limite",
      "type": "datetime",
      "layout": {
        "row": "Row_Action3_Deadline",
        "columns": null
      },
      "id": "Field_Action3_Deadline",
      "key": "action3Deadline",
      "dateLabel": "Date",
      "timeLabel": "Heure",
      "timeSerializingFormat": "utc_offset",
      "timeInterval": 15
    },
    {
      "label": "Ressources nécessaires",
      "type": "textarea",
      "layout": {
