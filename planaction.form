        "columns": null
      },
      "id": "Field_Action2_Deadline",
      "key": "action2Deadline",
      "dateLabel": "Date",
      "timeLabel": "Heure",
      "timeSerializingFormat": "utc_offset",
      "timeInterval": 15
    },
    {
      "label": "Ressources nécessaires",
      "type": "textarea",
      "layout": {
        "row": "Row_Action2_Resources",
        "columns": null
      },
      "id": "Field_Action2_Resources",
      "key": "action2Resources",
      "description": "Budget, équipement, personnel, formation, etc.",
      "rows": 2
    },
    {
      "label": "Indicateurs de succès",
      "type": "textarea",
      "layout": {
        "row": "Row_Action2_KPI",
        "columns": null
      },
      "id": "Field_Action2_KPI",
      "key": "action2KPI",
      "description": "Comment mesurer le succès de cette action ?",
      "rows": 2
    },
    {
      "text": "### Action 3",
      "type": "text",
      "layout": {
        "row": "Row_Action3_Header",
        "columns": null
      },
      "id": "Text_Action3_Header"
    },
    {
      "label": "Type d'action",
      "values": [
        {
          "label": "Action corrective (traite la cause)",
          "value": "corrective"
        },
        {
          "label": "Action préventive (évite la récurrence)",
          "value": "preventive"
        },
        {
          "label": "Action d'amélioration",
          "value": "improvement"
        }
      ],
      "type": "select",
      "layout": {
        "row": "Row_Action3_Type",
        "columns": null
      },
      "id": "Field_Action3_Type",
      "key": "action3Type",
      "searchable": true
    },
    {
      "label": "Description de l'action",
      "type": "textarea",
      "layout": {
        "row": "Row_Action3_Desc",
        "columns": null
      },
      "id": "Field_Action3_Description",
      "key": "action3Description",
      "description": "Décrivez précisément l'action à réaliser",
      "rows": 4
    },
    {
      "label": "Responsable de l'action",
      "type": "textfield",
      "layout": {
        "row": "Row_Action3_Owner",
        "columns": null
      },
      "id": "Field_Action3_Owner",
      "key": "action3Owner",
