    },
    {
      "text": "---",
      "type": "text",
      "layout": {
        "row": "Row_Sep3",
        "columns": null
      },
      "id": "Text_Sep3"
    },
    {
      "text": "##  Budget et ressources globales",
      "type": "text",
      "layout": {
        "row": "Row_Header3",
        "columns": null
      },
      "id": "Text_Budget_Header"
    },
    {
      "label": "Budget total estimé",
      "type": "textfield",
      "layout": {
        "row": "Row_Budget",
        "columns": null
      },
      "id": "Field_Budget",
      "key": "totalBudget",
      "description": "Montant estimé pour toutes les actions"
    },
    {
      "label": "Délai global de mise en œuvre",
      "type": "textfield",
      "layout": {
        "row": "Row_Timeline",
        "columns": null
      },
      "id": "Field_Timeline",
      "key": "implementationTimeline",
      "description": "Exemple: 3 mois, 6 semaines, etc."
    },
    {
      "label": "Commentaires sur le plan",
      "type": "textarea",
      "layout": {
        "row": "Row_Comments",
        "columns": null
      },
      "id": "Field_Plan_Comments",
      "key": "planComments",
      "description": "Remarques, dépendances, contraintes, etc.",
      "rows": 4
    },
    {
      "label": "Soumettre le plan d'actions",
      "action": "submit",
      "type": "button",
      "layout": {
        "row": "Row_Submit",
        "columns": null
      },
      "id": "Field_Submit"
