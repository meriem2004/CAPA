{
  "executionPlatform": "Camunda Cloud",
  "executionPlatformVersion": "8.8.0",
  "exporter": {
    "name": "Camunda Web Modeler",
    "version": "7b5e780"
  },
  "schemaVersion": 19,
  "id": "form_execute",
  "components": [
    {
      "text": "## 🎯 Exécution des actions CAPA",
      "type": "text",
      "layout": {
        "row": "Row_Header0",
        "columns": null
      },
      "id": "Text_Header"
    },
    {
      "text": "Cette étape permet de suivre et documenter l'exécution des actions correctrices et préventives approuvées.",
      "type": "text",
      "layout": {
        "row": "Row_Info",
        "columns": null
      },
      "id": "Text_Info"
    },
    {
      "text": "---",
      "type": "text",
      "layout": {
        "row": "Row_Sep1",
        "columns": null
      },
      "id": "Text_Sep1"
    },
    {
      "text": "## 📋 Informations CAPA",
      "type": "text",
      "layout": {
        "row": "Row_Header1",
        "columns": null
      },
      "id": "Text_CAPA_Header"
    },
    {
      "text": "**Numéro CAPA:** {{capaNumber}}\n\n**Titre:** {{capaTitle}}\n\n**Département:** {{department}}\n\n**Priorité:** {{priority}}\n\n**Budget total:** {{totalAllocatedBudget}}",
      "type": "text",
      "layout": {
        "row": "Row_CAPA_Info",
        "columns": null
      },
      "id": "Text_CAPA_Info"
    },
    {
      "text": "---",
      "type": "text",
      "layout": {
        "row": "Row_Sep2",
        "columns": null
      },
      "id": "Text_Sep2"
    },
    {
      "text": "## ⚙️ Exécution Action 1",
      "type": "text",
      "layout": {
        "row": "Row_Header2",
        "columns": null
      },
      "id": "Text_Action1_Header"
    },
    {
      "text": "**Type:** {{action1Type}}\n\n**Description:** {{action1Description}}\n\n**Responsable:** {{confirmedOwner1}}\n\n**Date limite:** {{action1Deadline}}\n\n**Budget alloué:** {{allocatedBudget1}}",
      "type": "text",
      "layout": {
        "row": "Row_Action1_Info",
        "columns": null
      },
      "id": "Text_Action1_Info"
    },
    {
      "label": "Statut d'exécution Action 1",
      "values": [
        {
          "label": "🔵 Non démarrée",
          "value": "not_started"
        },
        {
          "label": "🟡 En cours",
          "value": "in_progress"
        },
        {
          "label": "🟢 Terminée",
          "value": "completed"
        },
        {
          "label": "🔴 Bloquée",
          "value": "blocked"
        },
        {
          "label": "⚪ Annulée",
          "value": "cancelled"
        }
      ],
      "type": "select",
      "layout": {
        "row": "Row_Action1_Status",
        "columns": null
      },
      "id": "Field_Action1_Status",
      "key": "action1Status",
      "validate": {
        "required": true
      },
      "searchable": true,
      "defaultValue": "in_progress"
    },
    {
      "label": "Pourcentage d'avancement (%)",
      "type": "number",
      "layout": {
        "row": "Row_Action1_Progress",
        "columns": null
      },
      "id": "Field_Action1_Progress",
      "key": "action1Progress",
      "validate": {
        "required": true,
        "min": 0,
        "max": 100
      },
      "description": "Indiquez le pourcentage de complétion (0-100%)",
      "defaultValue": 0
    },
    {
      "label": "Date de début réelle",
      "type": "datetime",
      "layout": {
        "row": "Row_Action1_StartDate",
        "columns": null
      },
      "id": "Field_Action1_StartDate",
      "key": "action1StartDate",
      "validate": {
        "required": true
      },
      "dateLabel": "Date",
      "timeLabel": "Heure",
      "timeSerializingFormat": "utc_offset",
      "timeInterval": 15
    },
    {
      "label": "Date de fin réelle",
      "type": "datetime",
      "layout": {
        "row": "Row_Action1_EndDate",
        "columns": null
      },
      "id": "Field_Action1_EndDate",
      "key": "action1EndDate",
      "dateLabel": "Date",
      "timeLabel": "Heure",
      "timeSerializingFormat": "utc_offset",
      "timeInterval": 15,
      "description": "À remplir uniquement si l'action est terminée",
      "conditional": {
        "hide": "=action1Status != \"completed\""
      }
    },
    {
      "label": "Détails de l'exécution",
      "type": "textarea",
      "layout": {
        "row": "Row_Action1_Details",
        "columns": null
      },
      "id": "Field_Action1_Details",
      "key": "action1ExecutionDetails",
      "validate": {
        "required": true,
        "minLength": 20
      },
      "description": "Décrivez les étapes réalisées, les méthodes utilisées, les résultats obtenus",
      "rows": 5
    },
    {
      "label": "Budget consommé",
      "type": "textfield",
      "layout": {
        "row": "Row_Action1_BudgetSpent",
        "columns": null
      },
      "id": "Field_Action1_BudgetSpent",
      "key": "action1BudgetSpent",
      "description": "Montant réellement dépensé pour cette action",
      "placeholder": "Ex: 2500 EUR"
    },
    {
      "label": "Personnes impliquées",
      "type": "textarea",
      "layout": {
        "row": "Row_Action1_Team",
        "columns": null
      },
      "id": "Field_Action1_Team",
      "key": "action1TeamInvolved",
      "description": "Liste des personnes ayant participé à l'exécution",
      "rows": 2
    },
    {
      "label": "Difficultés rencontrées",
      "type": "textarea",
      "layout": {
        "row": "Row_Action1_Issues",
        "columns": null
      },
      "id": "Field_Action1_Issues",
      "key": "action1Issues",
      "description": "Obstacles, problèmes ou imprévus rencontrés",
      "rows": 3
    },
    {
      "label": "Preuves et documents",
      "type": "textarea",
      "layout": {
        "row": "Row_Action1_Evidence",
        "columns": null
      },
      "id": "Field_Action1_Evidence",
      "key": "action1Evidence",
      "description": "Références aux documents, photos, rapports de tests, etc.",
      "rows": 2
    },
    {
      "label": "Raison du blocage",
      "type": "textarea",
      "layout": {
        "row": "Row_Action1_BlockReason",
        "columns": null
      },
      "id": "Field_Action1_BlockReason",
      "key": "action1BlockReason",
      "validate": {
        "required": true,
        "minLength": 10
      },
      "description": "Expliquez pourquoi l'action est bloquée et les mesures nécessaires",
      "rows": 4,
      "conditional": {
        "hide": "=action1Status != \"blocked\""
      }
    },
    {
      "text": "---",
      "type": "text",
      "layout": {
        "row": "Row_Sep3",
        "columns": null
      },
      "id": "Text_Sep3"
