        "columns": null
      },
      "id": "Field_Total_Budget_Spent",
      "key": "totalBudgetSpent",
      "validate": {
        "required": true
      },
      "description": "Somme des budgets consommés pour toutes les actions",
      "placeholder": "Ex: 8500 EUR"
    },
    {
      "label": "Écart budgétaire",
      "type": "textarea",
      "layout": {
        "row": "Row_Budget_Variance",
        "columns": null
      },
      "id": "Field_Budget_Variance",
      "key": "budgetVarianceExplanation",
      "description": "Expliquez les écarts significatifs entre budget prévu et budget consommé",
      "rows": 3
    },
    {
      "label": "Respect des délais",
      "values": [
        {
          "label": "✅ Toutes les actions dans les délais",
          "value": "on_time"
        },
        {
          "label": "⚠️ Légers retards (<1 semaine)",
          "value": "slight_delay"
        },
        {
          "label": "🔴 Retards importants (>1 semaine)",
          "value": "significant_delay"
        },
        {
          "label": "❌ Échéances dépassées",
          "value": "overdue"
        }
      ],
      "type": "select",
      "layout": {
        "row": "Row_Timeline_Status",
        "columns": null
      },
      "id": "Field_Timeline_Status",
      "key": "timelineStatus",
