    },
    {
      "label": "Gravité de l'impact",
      "values": [
        {
          "label": "1 - Négligeable",
          "value": "1"
        },
        {
          "label": "2 - Mineure",
          "value": "2"
        },
        {
          "label": "3 - Modérée",
          "value": "3"
        },
        {
          "label": "4 - Majeure",
          "value": "4"
        },
        {
          "label": "5 - Catastrophique",
          "value": "5"
        }
      ],
      "type": "select",
      "layout": {
        "row": "Row_Risk3_Severity",
        "columns": null
      },
      "id": "Field_Risk3_Severity",
