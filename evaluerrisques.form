      }
    },
    {
      "label": "Mesures de mitigation",
      "type": "textarea",
      "layout": {
        "row": "Row_Risk3_Mitigation",
        "columns": null
      },
      "id": "Field_Risk3_Mitigation",
      "key": "risk3Mitigation",
      "description": "Actions pour réduire ou éliminer ces risques",
      "rows": 3,
      "conditional": {
        "hide": "=action3Description = null or action3Description = \"\""
      }
    },
    {
      "text": "---",
      "type": "text",
      "layout": {
        "row": "Row_Sep3",
        "columns": null
      },
      "id": "Text_Sep3"
    },
    {
      "text": "## 🎯 Évaluation globale des risques",
      "type": "text",
      "layout": {
        "row": "Row_Header3",
        "columns": null
      },
      "id": "Text_Global_Header"
    },
    {
      "label": "Niveau de risque global du plan",
      "values": [
        {
          "label": "Faible - Plan peut être approuvé",
          "value": "low"
        },
        {
          "label": "Modéré - Plan acceptable avec surveillance",
          "value": "moderate"
        },
        {
          "label": "Élevé - Plan nécessite des ajustements",
          "value": "high"
        },
        {
          "label": "Critique - Plan doit être revu",
          "value": "critical"
        }
      ],
      "type": "select",
      "layout": {
        "row": "Row_Global_Risk",
        "columns": null
      },
      "id": "Field_Global_Risk",
      "key": "globalRiskLevel",
      "validate": {
        "required": true
      },
      "searchable": true
    },
    {
      "label": "Risques résiduels",
      "type": "textarea",
      "layout": {
        "row": "Row_Residual",
        "columns": null
      },
      "id": "Field_Residual_Risk",
      "key": "residualRisks",
      "description": "Risques qui subsisteront même après mise en œuvre des mesures de mitigation",
      "rows": 3
    },
    {
      "label": "Recommandations",
      "type": "textarea",
      "layout": {
        "row": "Row_Recommendations",
        "columns": null
      },
      "id": "Field_Recommendations",
      "key": "riskRecommendations",
      "validate": {
        "required": true
      },
      "description": "Recommandations pour la direction concernant l'approbation du plan",
      "rows": 4
    },
    {
      "label": "Soumettre l'évaluation des risques",
      "action": "submit",
      "type": "button",
      "layout": {
        "row": "Row_Submit",
        "columns": null
      },
      "id": "Field_Submit"
    }
