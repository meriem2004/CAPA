      "key": "risk2Probability",
      "searchable": true,
      "conditional": {
        "hide": "=action2Description = null or action2Description = \"\""
      }
    },
    {
      "label": "Gravité de l'impact",
      "values": [
        {
          "label": "1 - Négligeable",
          "value": "1"
        },
        {
          "label": "2 - Mineure",
          "value": "2"
        },
        {
          "label": "3 - Modérée",
          "value": "3"
        },
        {
          "label": "4 - Majeure",
          "value": "4"
        },
        {
          "label": "5 - Catastrophique",
          "value": "5"
        }
      ],
      "type": "select",
      "layout": {
        "row": "Row_Risk2_Severity",
        "columns": null
      },
      "id": "Field_Risk2_Severity",
      "key": "risk2Severity",
      "searchable": true,
      "conditional": {
        "hide": "=action2Description = null or action2Description = \"\""
      }
    },
    {
      "label": "Mesures de mitigation",
      "type": "textarea",
      "layout": {
        "row": "Row_Risk2_Mitigation",
        "columns": null
      },
      "id": "Field_Risk2_Mitigation",
      "key": "risk2Mitigation",
      "description": "Actions pour réduire ou éliminer ces risques",
      "rows": 3,
      "conditional": {
        "hide": "=action2Description = null or action2Description = \"\""
      }
    },
    {
      "text": "### Évaluation Action 3",
      "type": "text",
      "layout": {
        "row": "Row_Risk3_Header",
        "columns": null
      },
      "id": "Text_Risk3_Header",
      "conditional": {
        "hide": "=action3Description = null or action3Description = \"\""
      }
    },
    {
      "label": "Risques identifiés pour l'Action 3",
      "type": "textarea",
      "layout": {
        "row": "Row_Risk3_Description",
        "columns": null
      },
      "id": "Field_Risk3_Description",
      "key": "risk3Description",
      "description": "Listez les risques potentiels",
      "rows": 4,
      "conditional": {
        "hide": "=action3Description = null or action3Description = \"\""
      }
    },
    {
      "label": "Probabilité d'occurrence",
      "values": [
        {
          "label": "1 - Très faible (< 10%)",
          "value": "1"
        },
        {
          "label": "2 - Faible (10-30%)",
          "value": "2"
        },
        {
          "label": "3 - Moyenne (30-50%)",
          "value": "3"
        },
        {
          "label": "4 - Élevée (50-80%)",
          "value": "4"
        },
        {
          "label": "5 - Très élevée (> 80%)",
          "value": "5"
        }
      ],
      "type": "select",
      "layout": {
