{
  "executionPlatform": "Camunda Cloud",
  "executionPlatformVersion": "8.8.0",
  "exporter": {
    "name": "Camunda Web Modeler",
    "version": "7b5e780"
  },
  "schemaVersion": 19,
  "id": "form_allocate",
  "components": [
    {
      "text": "## 📋 Informations CAPA",
      "type": "text",
      "layout": {
        "row": "Row_Header0",
        "columns": null
      },
      "id": "Text_CAPA_Header"
    },
    {
      "text": "**Numéro CAPA:** {{capaNumber}}\n\n**Titre:** {{capaTitle}}\n\n**Département:** {{department}}\n\n**Priorité:** {{priority}}",
      "type": "text",
      "layout": {
        "row": "Row_CAPA_Info",
        "columns": null
      },
      "id": "Text_CAPA_Info"
    },
    {
      "text": "---",
      "type": "text",
      "layout": {
        "row": "Row_Sep1",
        "columns": null
      },
      "id": "Text_Sep1"
    },
    {
      "text": "## 📝 Plan d'actions proposé",
      "type": "text",
      "layout": {
        "row": "Row_Header1",
        "columns": null
      },
      "id": "Text_Plan_Header"
    },
    {
      "text": "### Action 1",
      "type": "text",
      "layout": {
        "row": "Row_Action1_Header",
        "columns": null
      },
      "id": "Text_Action1_Header"
    },
    {
      "text": "**Type:** {{action1Type}}\n\n**Description:** {{action1Description}}\n\n**Responsable suggéré:** {{action1Owner}}\n\n**Date limite:** {{action1Deadline}}\n\n**Ressources demandées:** {{action1Resources}}\n\n**Indicateurs de succès:** {{action1KPI}}",
      "type": "text",
      "layout": {
        "row": "Row_Action1_Details",
        "columns": null
      },
      "id": "Text_Action1_Details"
    },
    {
      "text": "### Action 2",
      "type": "text",
      "layout": {
        "row": "Row_Action2_Header",
        "columns": null
      },
      "id": "Text_Action2_Header",
      "conditional": {
        "hide": "=action2Description = null or action2Description = \"\""
      }
    },
    {
      "text": "**Type:** {{action2Type}}\n\n**Description:** {{action2Description}}\n\n**Responsable suggéré:** {{action2Owner}}\n\n**Date limite:** {{action2Deadline}}\n\n**Ressources demandées:** {{action2Resources}}\n\n**Indicateurs de succès:** {{action2KPI}}",
      "type": "text",
      "layout": {
        "row": "Row_Action2_Details",
        "columns": null
      },
      "id": "Text_Action2_Details",
      "conditional": {
        "hide": "=action2Description = null or action2Description = \"\""
      }
    },
    {
      "text": "### Action 3",
