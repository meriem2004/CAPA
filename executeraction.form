{
  "executionPlatform": "Camunda Cloud",
  "executionPlatformVersion": "8.4.0",
  "exporter": {
    "name": "Camunda Web Modeler",
    "version": "9d4d45f"
  },
  "schemaVersion": 19,
  "id": "form_execute",
  "components": [
    {
      "label": "📄 Document CAPA généré",
      "components": [
        {
          "type": "textfield",
          "id": "displayFileName",
          "label": "📁 Nom du fichier",
          "key": "pdfFileName",
          "disabled": true,
          "layout": {
            "row": "Row_filename"
          }
        },
        {
          "type": "textfield",
          "id": "displayGeneratedDate",
          "label": "📅 Date de génération",
          "key": "documentGeneratedAt",
          "disabled": true,
          "layout": {
            "row": "Row_date"
          }
        },
        {
          "type": "textfield",
          "id": "displayBucket",
          "label": "🗂️ Bucket MinIO",
          "key": "s3Bucket",
          "disabled": true,
          "layout": {
            "row": "Row_bucket"
          }
        },
        {
          "type": "textfield",
          "id": "displayPath",
          "label": "📍 Chemin du fichier",
          "key": "pdfS3Key",
          "disabled": true,
          "layout": {
            "row": "Row_path"
          }
        },
        {
          "type": "text",
          "id": "docUrl",
          "label": "🔗 Lien direct vers le document",
          "key": "documentUrl",
          "defaultValue": "={{\"http://localhost:9000/\" + s3Bucket + \"/\" + pdfS3Key}}",
          "description": "Copiez ce lien ou cliquez pour ouvrir",
          "layout": {
            "row": "Row_url"
          }
        },
        {
          "type": "html",
          "id": "actionButtons",
          "html": "<div style='margin: 20px 0; display: flex; gap: 10px; flex-wrap: wrap;'>\n  <a href='http://localhost:9000/capadocuments/documents/' target='_blank' style='display: inline-block; background: #0d6efd; color: white; padding: 12px 24px; border-radius: 6px; text-decoration: none; font-weight: 600;'>👁️ Ouvrir le dossier documents</a>\n  <a href='http://localhost:9001/browser/capadocuments/documents/' target='_blank' style='display: inline-block; background: #6f42c1; color: white; padding: 12px 24px; border-radius: 6px; text-decoration: none; font-weight: 600;'>🗄️ MinIO Console</a>\n</div>\n<div style='background: #d1ecf1; border-left: 4px solid #0dcaf0; padding: 12px; margin-top: 15px; border-radius: 4px;'>\n  <strong style='color: #055160;'>💡 Comment accéder au document :</strong>\n  <ol style='margin: 10px 0 0 20px; color: #055160;'>\n    <li>Copiez le lien direct ci-dessus</li>\n    <li>Collez-le dans un nouvel onglet de votre navigateur</li>\n    <li>Ou cliquez sur \"Ouvrir le dossier documents\" et trouvez votre fichier</li>\n  </ol>\n</div>",
          "layout": {
            "row": "Row_buttons"
          }
        }
      ],
      "showOutline": true,
      "type": "group",
      "id": "documentSection",
      "path": "documentSection",
      "layout": {
        "row": "Row_0lrhglz"
      }
    },
    {
      "type": "separator",
      "id": "Field_1wk9ewu",
      "layout": {
        "row": "Row_1o7z604"
      }
    },
    {
      "label": "✅ Étapes d'exécution",
      "components": [
        {
          "label": "Cochez les étapes complétées",
          "values": [
            {
              "label": "Préparation des ressources nécessaires",
              "value": "step1"
            },
            {
              "label": "Mise en œuvre de l'action corrective/préventive",
              "value": "step2"
            },
            {
              "label": "Vérification de la mise en œuvre",
              "value": "step3"
            },
            {
              "label": "Documentation des preuves d'exécution",
              "value": "step4"
            },
            {
              "label": "Communication aux parties prenantes",
              "value": "step5"
            }
          ],
          "type": "checklist",
          "id": "stepsList",
          "key": "completedSteps",
          "validate": {
            "required": true
          },
          "layout": {
            "row": "Row_03z4i36"
          }
        },
        {
          "label": "Pourcentage d'avancement global (%)",
          "type": "number",
          "id": "progressPercentage",
          "key": "progressPercentage",
          "validate": {
            "required": true,
            "min": 0,
            "max": 100
          },
          "defaultValue": 0,
          "increment": 10,
          "layout": {
            "row": "Row_18uqrqd"
          }
        }
      ],
      "showOutline": true,
      "type": "group",
      "id": "executionSteps",
      "path": "executionSteps",
      "layout": {
        "row": "Row_0g96v4r"
      }
    },
    {
      "type": "separator",
      "id": "Field_1r1arsg",
      "layout": {
        "row": "Row_1xha60c"
      }
    },
    {
      "label": "📎 Preuves d'exécution",
      "components": [
        {
          "label": "Description détaillée de l'exécution",
          "type": "textarea",
          "id": "executionDescription",
          "key": "executionDescription",
          "validate": {
            "required": true,
            "minLength": 50
          },
          "rows": 4,
          "description": "Décrivez comment l'action a été exécutée (minimum 50 caractères)",
          "layout": {
            "row": "Row_1ixnzyp"
          }
        },
        {
          "type": "html",
          "id": "minioUploadInstructions",
          "html": "<div style='background: #e7f3ff; border-left: 4px solid #0d6efd; padding: 15px; margin: 15px 0; border-radius: 4px;'>\n  <strong style='color: #0d6efd;'>💡 Instructions pour uploader des preuves :</strong>\n  <ol style='margin: 8px 0 0 20px; color: #084298; line-height: 1.6;'>\n    <li>Ouvrez <a href='http://localhost:9001' target='_blank' style='color: #0d6efd; font-weight: 600;'>MinIO Console</a></li>\n    <li>Login : <code style='background: rgba(0,0,0,0.05); padding: 2px 6px;'>minioadmin / minioadmin123</code></li>\n    <li>Naviguez : <strong>Buckets</strong> → <strong>capadocuments</strong></li>\n    <li>Créez le dossier selon votre CAPA (ex: CAPA-xxx/evidence/)</li>\n    <li>Uploadez vos fichiers de preuve</li>\n    <li>Listez les noms ci-dessous</li>\n  </ol>\n</div>",
          "layout": {
            "row": "Row_minioInstructions"
          }
        },
        {
          "label": "Liste des fichiers de preuve uploadés",
          "type": "textarea",
          "id": "evidenceFiles",
          "key": "evidenceFilesList",
          "rows": 3,
          "description": "Un fichier par ligne",
          "placeholder": "photo_avant.jpg\nphoto_apres.jpg\nrapport_verification.pdf",
          "layout": {
            "row": "Row_0f2jjq0"
          }
        },
        {
          "label": "Chemin MinIO des preuves",
          "type": "textfield",
          "id": "minioPathEvidence",
          "key": "minioEvidencePath",
          "defaultValue": "={{s3Bucket + \"/\" + capaNumber + \"/evidence/\"}}",
          "disabled": true,
          "layout": {
            "row": "Row_1wfbs01"
          }
        },
        {
          "label": "✅ J'ai uploadé au moins un fichier de preuve",
          "type": "checkbox",
          "id": "evidenceUploaded",
          "key": "evidenceUploaded",
          "validate": {
            "required": true
          },
          "layout": {
            "row": "Row_02obof4"
          }
        }
      ],
      "showOutline": true,
      "type": "group",
      "id": "evidenceGroup",
      "path": "evidence",
      "layout": {
        "row": "Row_1yi4q5z"
      }
    },
    {
      "type": "separator",
      "id": "Field_1sfc7hb",
      "layout": {
        "row": "Row_1xev9yv"
      }
    },
    {
      "label": "⚠️ Obstacles et solutions",
      "components": [
        {
          "label": "Des obstacles ont-ils été rencontrés ?",
          "values": [
            {
              "label": "Oui",
              "value": "yes"
            },
            {
              "label": "Non",
              "value": "no"
            }
          ],
          "type": "radio",
          "id": "hasObstacles",
          "key": "hasObstacles",
          "validate": {
            "required": true
          },
          "defaultValue": "no",
          "layout": {
            "row": "Row_06qjf5r"
          }
        },
        {
          "label": "Description des obstacles",
          "type": "textarea",
          "id": "obstaclesDescription",
          "key": "obstaclesDescription",
          "rows": 3,
          "conditional": {
            "hide": "=hasObstacles != \"yes\""
          },
          "validate": {
            "required": "=hasObstacles = \"yes\""
          },
          "layout": {
            "row": "Row_1n7p91m"
          }
        },
        {
          "label": "Solutions apportées",
          "type": "textarea",
          "id": "solutionsApplied",
          "key": "solutionsApplied",
          "rows": 3,
          "conditional": {
            "hide": "=hasObstacles != \"yes\""
          },
          "validate": {
            "required": "=hasObstacles = \"yes\""
          },
          "layout": {
            "row": "Row_0ph4lbv"
          }
        }
      ],
      "showOutline": true,
      "type": "group",
      "id": "issuesGroup",
      "path": "issues",
      "layout": {
        "row": "Row_1bkirq2"
      }
    },
    {
      "type": "separator",
      "id": "Field_1ey48f9",
      "layout": {
        "row": "Row_0kgmh93"
      }
    },
    {
      "label": "📅 Dates",
      "components": [
        {
          "subtype": "datetime",
          "type": "datetime",
          "id": "actualExecutionDate",
          "label": "Date d'exécution réelle",
          "key": "actualExecutionDate",
          "validate": {
            "required": true
          },
          "dateLabel": "Date",
          "timeLabel": "Heure",
          "timeSerializingFormat": "utc_offset",
          "timeInterval": 15,
          "layout": {
            "row": "Row_0m9uuwm"
          }
        },
        {
          "subtype": "date",
          "type": "datetime",
          "id": "plannedDeadline",
          "label": "Date limite prévue",
          "key": "targetResolutionDate",
          "disabled": true,
          "layout": {
            "row": "Row_0dk695u"
          }
        }
      ],
      "showOutline": true,
      "type": "group",
      "id": "datesGroup",
      "path": "dates",
      "layout": {
        "row": "Row_179occ5"
      }
    },
    {
      "type": "separator",
      "id": "Field_0f10dfl",
      "layout": {
        "row": "Row_03we8oa"
      }
    },
    {
      "label": "✓ Validation",
      "components": [
        {
          "label": "Je confirme que l'action a été exécutée conformément au plan",
          "type": "checkbox",
          "id": "confirmCompletion",
          "key": "confirmCompletion",
          "validate": {
            "required": true
          },
          "layout": {
            "row": "Row_0xlluyi"
          }
        },
        {
          "label": "Commentaires additionnels",
          "type": "textarea",
          "id": "additionalComments",
          "key": "additionalComments",
          "rows": 2,
          "layout": {
            "row": "Row_06nqv4m"
          }
        }
      ],
      "showOutline": true,
      "type": "group",
      "id": "validationGroup",
      "path": "validation",
      "layout": {
        "row": "Row_0rdtcv7"
      }
    },
    {
      "label": "✅ Valider l'exécution",
      "action": "submit",
      "type": "button",
      "id": "submitExecution",
      "key": "submit",
      "layout": {
        "row": "Row_1lfg66y"
      }
    }
  ],
  "type": "default"
}